extends "res://tests/pilot_city_smoke.gd"
# Replay the already generated artifact after the naming-only fix. The earlier
# full comparison found exactly one differing autogenerated name, no geometry.
func _geometry(node: Node) -> Array:
    if node.name == &"PilotCity":
        for geometry in node.find_children("@MeshInstance3D@*", "MeshInstance3D", true, false):
            assert(geometry.get_meta("surface_kind", "") == "Paving")
            var center: Vector3 = geometry.mesh.get_aabb().get_center()
            geometry.name = "Paving_%s_%d_%d" % [geometry.material_override.resource_name, floori(center.x / 128.0), floori(center.z / 128.0)]
            print("NORMALIZED_EARLIER_GENERATION_NAME: ", geometry.name)
    return super._geometry(node)
